# Base URL of the Worker (no trailing slash). For the APK use the deployed URL,
# e.g. https://choreapp-api.<your-subdomain>.workers.dev
VITE_API_URL=http://localhost:8787
# Set only for the Google Play build (`pnpm aab` does it): no self-update check.
# VITE_DISTRIBUTION=play   (test-server build: staging, `pnpm apk:staging` with .env.staging)
