{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "choreapp-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // Built-in sticker/avatar/frame images (packages/seed). Served directly by
  // Cloudflare as static assets: free and not counted as Worker requests.
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "choreapp",
      // Replace with the id printed by `wrangler d1 create choreapp` before deploying.
      "database_id": "aa2444fe-a595-4a12-8912-c5347958645e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "choreapp-files" }],
  // Cloudflare Email Sending (password reset codes). The sender domain must be onboarded.
  "send_email": [{ "name": "EMAIL" }],
  // One trigger (Free plan allows 5): occurrences, reminders, quiet-hours digest, cleanup.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Secrets (wrangler secret put): FILE_SIGNING_KEY, FCM_SERVICE_ACCOUNT

  // Test server (`--env staging`): own Worker, D1 and R2, never production data.
  // No cron: tasks and immediate pushes work without it; only the daily reminder
  // and the quiet-hours digest wait for a cron. Secrets: `wrangler secret put ... --env staging`.
  "env": {
    "staging": {
      "name": "choreapp-api-staging",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "choreapp-staging",
          // Replace with the id printed by `wrangler d1 create choreapp-staging --location weur`.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "choreapp-files-staging" }],
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": [] }
    }
  }
}
