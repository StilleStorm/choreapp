{
  "name": "@choreapp/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply choreapp --local",
    "db:migrate:remote": "wrangler d1 migrations apply choreapp --remote",
    "db:seed:local": "wrangler d1 execute choreapp --local --file=seed/builtin.sql",
    "db:seed:remote": "wrangler d1 execute choreapp --remote --file=seed/builtin.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@choreapp/core": "workspace:*",
    "@choreapp/shared": "workspace:*",
    "hono": "^4.13.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261124.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
